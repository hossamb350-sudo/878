{
  "entities": {
    "News": {
      "title": "News",
      "description": "A news article",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "shortDescription": { "type": "string" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string" },
        "isBreaking": { "type": "boolean" },
        "createdAt": { "type": "number", "description": "Timestamp in ms" }
      },
      "required": ["title", "shortDescription", "content", "category", "createdAt"]
    },
    "Video": {
      "title": "Video",
      "description": "A video entry in the Watch section",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "url": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "duration": { "type": "string" },
        "views": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["title", "url", "createdAt"]
    },
    "LiveStream": {
      "title": "LiveStream Settings",
      "description": "Current live stream properties and channels",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "streamUrl": { "type": "string" },
        "iconUrl": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["tv", "radio"] },
        "isActive": { "type": "boolean" },
        "order": { "type": "number" },
        "badge": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["isActive"]
    },
    "LeaderContent": {
      "title": "Leader Content",
      "description": "Content for the leader section",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "type": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["title", "type", "content", "createdAt"]
    },
    "QuranContent": {
      "title": "Quran Content",
      "description": "Link for Quran section",
      "type": "object",
      "properties": {
        "link": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["isActive"]
    },
    "Event": {
      "title": "Event",
      "description": "Event calendar entry",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "number" },
        "type": { "type": "string" }
      },
      "required": ["title", "date", "type"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Notifications to display",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["title", "body", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "Platform user information",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "createdAt": { "type": "number" },
        "lastLogin": { "type": "number" }
      },
      "required": ["email", "role", "createdAt"]
    },
    "QuranBookmark": {
      "title": "Quran Bookmark",
      "description": "Bookmarks in Quran lessons",
      "type": "object",
      "properties": {
        "lessonId": { "type": "string" },
        "seriesId": { "type": "string" },
        "paragraphIndex": { "type": "number" },
        "text": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["lessonId", "seriesId", "paragraphIndex", "createdAt"]
    },
    "QuranNote": {
      "title": "Quran Note",
      "description": "Personal annotations on lesson paragraphs",
      "type": "object",
      "properties": {
        "lessonId": { "type": "string" },
        "paragraphIndex": { "type": "number" },
        "noteText": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["lessonId", "paragraphIndex", "noteText", "createdAt"]
    },
    "QuranHighlight": {
      "title": "Quran Highlight",
      "description": "Highlighted text chunks in lessons",
      "type": "object",
      "properties": {
        "lessonId": { "type": "string" },
        "paragraphIndex": { "type": "number" },
        "color": { "type": "string", "enum": ["yellow", "green", "underline"] },
        "createdAt": { "type": "number" }
      },
      "required": ["lessonId", "paragraphIndex", "color", "createdAt"]
    },
    "QuranReaderStats": {
      "title": "Quran Reader Stats",
      "description": "User reading metrics and progress logs",
      "type": "object",
      "properties": {
        "lessonsReadCount": { "type": "number" },
        "totalReadingTimeMinutes": { "type": "number" },
        "lastReadTimestamp": { "type": "number" },
        "progressLog": { "type": "array" }
      },
      "required": ["lessonsReadCount", "totalReadingTimeMinutes", "lastReadTimestamp"]
    },
    "QuranSeries": {
      "title": "Quran Series",
      "description": "A series of Quran lessons",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "order": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "title", "order"]
    },
    "QuranLesson": {
      "title": "Quran Lesson",
      "description": "A single Quran lesson with content",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "seriesId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "order": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "seriesId", "title", "content", "order"]
    },
    "QuranExcerpt": {
      "title": "Quran Excerpt",
      "description": "A short highlight from a Quran lesson",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "lessonId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "lessonId", "title", "content"]
    },
    "QuranSyllabus": {
      "title": "Quran Syllabus",
      "description": "Scheduled Quran study item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "lessonId": { "type": "string" },
        "lessonTitle": { "type": "string" },
        "seriesId": { "type": "string" },
        "seriesTitle": { "type": "string" },
        "durationType": { "type": "string", "enum": ["weeks", "months"] },
        "expiresAt": { "type": "number" },
        "eventId": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "lessonId", "expiresAt"]
    },
    "SocialLink": {
      "title": "Social Link",
      "description": "External social media links",
      "type": "object",
      "properties": {
        "platform": { "type": "string" },
        "label": { "type": "string" },
        "url": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["platform", "label", "url", "order", "createdAt"]
    },
    "CustomFooter": {
      "title": "Custom Footer Image Settings",
      "description": "Custom footer image settings",
      "type": "object",
      "properties": {
        "imageUrl": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["imageUrl"]
    },
    "AppVersionConfig": {
      "title": "App Version and Lock Config",
      "description": "Enforce minimum app version and display forced update messages",
      "type": "object",
      "properties": {
        "minRequiredVersion": { "type": "string" },
        "updateUrl": { "type": "string" },
        "lockMessage": { "type": "string" },
        "isEnabled": { "type": "boolean" },
        "updatedAt": { "type": "number" },
        "updatedBy": { "type": "string" }
      },
      "required": ["minRequiredVersion", "updateUrl", "lockMessage", "isEnabled", "updatedAt"]
    },
    "FeaturedTopic": {
      "title": "Featured Topic",
      "description": "Featured topics grouping categories",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "imageUrl": { "type": "string" },
        "categories": { "type": "array" },
        "isVisible": { "type": "boolean" },
        "order": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["title", "imageUrl", "categories", "isVisible", "order", "createdAt"]
    },
    "PrayerTimesConfig": {
      "title": "Prayer Times Configuration",
      "description": "Manual or automatic settings for prayer times in Taiz",
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["auto", "manual"] },
        "timings": { "type": "object" },
        "hijriDateOverride": { "type": "string" },
        "updatedAt": { "type": "number" },
        "updatedBy": { "type": "string" }
      },
      "required": ["mode", "timings", "updatedAt"]
    },
    "WeatherConfig": {
      "title": "Weather Configuration",
      "description": "Manual or automatic settings for weather in Taiz",
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["auto", "manual"] },
        "temp": { "type": "number" },
        "conditionText": { "type": "string" },
        "weatherCode": { "type": "number" },
        "humidity": { "type": "number" },
        "windSpeed": { "type": "number" },
        "updatedAt": { "type": "number" },
        "updatedBy": { "type": "string" }
      },
      "required": ["mode", "temp", "conditionText", "updatedAt"]
    },
    "PrayerAlertBroadcast": {
      "title": "Prayer Alert Broadcast",
      "description": "Instant broadcast trigger for adhan popup",
      "type": "object",
      "properties": {
        "prayerKey": { "type": "string" },
        "prayerName": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "number" },
        "triggeredBy": { "type": "string" }
      },
      "required": ["prayerKey", "prayerName", "timestamp"]
    },
    "FCMSettings": {
      "title": "FCM Settings",
      "description": "Firebase Cloud Messaging service account credentials for push notifications",
      "type": "object",
      "properties": {
        "serviceAccount": { "type": "string" },
        "updatedAt": { "type": "number" },
        "updatedBy": { "type": "string" }
      },
      "required": ["serviceAccount"]
    },
    "NotificationHistory": {
      "title": "Notification History",
      "description": "Log of sent push notifications",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" },
        "imageUrl": { "type": "string" },
        "contentType": { "type": "string" },
        "contentId": { "type": "string" },
        "contentTitle": { "type": "string" },
        "successCount": { "type": "number" },
        "failureCount": { "type": "number" },
        "tokensCount": { "type": "number" },
        "createdAt": { "type": "number" },
        "sentBy": { "type": "string" },
        "method": { "type": "string" }
      },
      "required": ["title", "createdAt"]
    }
  },
  "firestore": {
    "/settings/prayer_times_config": {
      "schema": { "$ref": "PrayerTimesConfig" },
      "description": "Prayer times mode and manual timings"
    },
    "/settings/weather_config": {
      "schema": { "$ref": "WeatherConfig" },
      "description": "Weather mode and manual conditions"
    },
    "/settings/prayer_alert_broadcast": {
      "schema": { "$ref": "PrayerAlertBroadcast" },
      "description": "Adhan announcement broadcast"
    },
    "/featured_topics/{topicId}": {
      "schema": { "$ref": "FeaturedTopic" },
      "description": "Featured topics shown on home page"
    },
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "User profiles and roles"
    },
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": { "$ref": "QuranBookmark" },
      "description": "User saved bookmarks"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": { "$ref": "QuranNote" },
      "description": "User notes and thoughts"
    },
    "/users/{userId}/highlights/{highlightId}": {
      "schema": { "$ref": "QuranHighlight" },
      "description": "User highlighted text"
    },
    "/users/{userId}/stats/reader": {
      "schema": { "$ref": "QuranReaderStats" },
      "description": "Global user reader progress"
    },
    "/news/{newsId}": {
      "schema": { "$ref": "News" },
      "description": "News articles"
    },
    "/videos/{videoId}": {
      "schema": { "$ref": "Video" },
      "description": "Videos in Watch section"
    },
    "/settings/livestream": {
      "schema": { "$ref": "LiveStream" },
      "description": "Live stream config"
    },
    "/settings/quran": {
      "schema": { "$ref": "QuranContent" },
      "description": "Quran section config"
    },
    "/settings/custom_footer": {
      "schema": { "$ref": "CustomFooter" },
      "description": "Custom footer image settings"
    },
    "/settings/app_version_config": {
      "schema": { "$ref": "AppVersionConfig" },
      "description": "Enforce minimum app version and display forced update messages"
    },
    "/leader/{contentId}": {
      "schema": { "$ref": "LeaderContent" },
      "description": "Content chunks for leader section"
    },
    "/events/{eventId}": {
      "schema": { "$ref": "Event" },
      "description": "Events and occasions"
    },
    "/notifications/{notifId}": {
      "schema": { "$ref": "Notification" },
      "description": "System Notifications"
    },
    "/social_links/{linkId}": {
      "schema": { "$ref": "SocialLink" },
      "description": "External social media links"
    },
    "/quran_series/{id}": {
      "schema": { "$ref": "QuranSeries" },
      "description": "Quran series data"
    },
    "/quran_lessons/{id}": {
      "schema": { "$ref": "QuranLesson" },
      "description": "Quran lessons content"
    },
    "/quran_excerpts/{id}": {
      "schema": { "$ref": "QuranExcerpt" },
      "description": "Quran highlights"
    },
    "/quran_syllabuses/{id}": {
      "schema": { "$ref": "QuranSyllabus" },
      "description": "Quran scheduled syllabuses"
    },
    "/settings/fcm": {
      "schema": { "$ref": "FCMSettings" },
      "description": "FCM Push Notifications Service Account Configuration"
    },
    "/notifications_history/{id}": {
      "schema": { "$ref": "NotificationHistory" },
      "description": "Push notification sent history logs"
    }
  }
}
