    "@capacitor/splash-screen": "^8.0.1",
    "@google/genai": "^2.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@southdevs/capacitor-google-auth": "^7.0.0",
