{
  "name": "taiz-media-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsx scripts/split-quran-data.ts && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "generate-assets": "node -e \"const fs = require('fs'); if (fs.existsSync('Resources/app-icon.png')) fs.copyFileSync('Resources/app-icon.png', 'Resources/icon.png');\" && npx capacitor-assets generate --assetPath Resources --android"
  },
