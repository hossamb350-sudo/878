{
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/admin/fcm-diagnostics",
      "destination": "/api/admin-fcm-diagnostics.js"
    },
    {
      "source": "/api/admin/send-notification",
      "destination": "/api/admin-send-notification.js"
    },
    {
      "source": "/api/push/fcm-broadcast",
      "destination": "/api/admin-send-notification.js"
    },
    {
      "source": "/.well-known/assetlinks.json",
      "destination": "/.well-known/assetlinks.json"
    },
    {
      "source": "/news/:slug",
      "destination": "/api/og.js?type=news&slug=:slug"
    },
    {
      "source": "/articles/:slug",
      "destination": "/api/og.js?type=articles&slug=:slug"
    },
    {
      "source": "/watch/:slug",
      "destination": "/api/og.js?type=watch&slug=:slug"
    },
    {
      "source": "/watch/channel/:slug",
      "destination": "/api/og.js?type=livestreams&slug=:slug"
    },
    {
      "source": "/leader/:slug",
      "destination": "/api/og.js?type=leader&slug=:slug"
    },
    {
      "source": "/events/activity/:slug",
      "destination": "/api/og.js?type=activities&slug=:slug"
    },
    {
      "source": "/topic/:slug",
      "destination": "/api/og.js?type=topics&slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
