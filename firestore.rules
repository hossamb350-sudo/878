rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    
    // Default Deny
    match /{document=**} { 
      allow read, write: if false; 
    }
    
    match /news/{newsId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /settings/livestream {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /settings/quran {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /leader/{contentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /events/{eventId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /notifications/{notifId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
