rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------
    // Helper functions
    // ---------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isSuperAdminEmail() {
      return isSignedIn() &&
        'email' in request.auth.token &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() == 'hossamb350@gmail.com';
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        isSuperAdminEmail() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().get('role', '') == 'admin')
      );
    }

    function isManager() {
      return isSignedIn() && (
        isSuperAdminEmail() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (getUserData().get('role', '') == 'admin' || getUserData().get('role', '') == 'manager'))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // Collections
    // ---------------------------------------------------------

    match /featured_topics/{id} {
      allow read: if true;
      allow write: if isManager();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isManager();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastLogin', 'email', 'notificationSettings', 'phoneNumber', 'bio']) ||
          (isSuperAdminEmail() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'displayName', 'photoURL', 'lastLogin', 'email']))
        )) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /users/{userId}/bookmarks/{id} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /users/{userId}/notes/{id} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /users/{userId}/highlights/{id} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /users/{userId}/stats/{id} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /news/{id} {
      allow read: if true;
      allow create, delete: if isManager();
      allow update: if isManager() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
        (request.resource.data.views is number || request.resource.data.views is int)
      );
    }

    match /articles/{id} {
      allow read: if true;
      allow create, delete: if isManager();
      allow update: if isManager() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
        (request.resource.data.views is number || request.resource.data.views is int)
      );
    }

    match /urgentNews/{id} {
      allow read: if true;
      allow write: if isManager();
    }

    match /newsMetadata/{id} {
      allow read: if true;
      allow write: if isManager();
    }

    match /videos/{id} {
      allow read: if true;
      allow create, delete: if isManager();
      allow update: if isManager() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
        (request.resource.data.views is number || request.resource.data.views is int)
      );
    }

    match /events/{id} {
      allow read: if true;
      allow write: if isManager();
    }

    match /activities/{id} {
      allow read: if true;
      allow write: if isManager();
    }

    match /livestreams/{id} {
      allow read: if true;
      allow write: if isManager();
    }

    match /notifications/{id} {
      allow read: if true;
      allow write: if isManager();
    }

    match /leader/{id} {
      allow read: if true;
      allow create, delete: if isManager();
      allow update: if isManager() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
        (request.resource.data.views is number || request.resource.data.views is int)
      );
    }

    match /social_links/{id} {
      allow read: if true;
      allow write: if isManager();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isManager();
    }

    match /authors/{id} {
      allow read: if true;
      allow write: if isManager();
    }

    match /deletions/{id} {
      allow read: if true;
      allow write: if isManager();
    }

    match /quran_series/{id} {
      allow read: if true;
      allow write: if isManager();
    }

    match /quran_lessons/{id} {
      allow read: if true;
      allow write: if isManager();
    }

    match /quran_excerpts/{id} {
      allow read: if true;
      allow write: if isManager();
    }

    match /quran_syllabuses/{id} {
      allow read: if true;
      allow write: if isManager();
    }

    match /newspapers/{id} {
      allow read: if true;
      allow write: if isManager();
    }

    match /newspaper_logs/{id} {
      allow read: if true;
      allow write: if isManager();
    }
  }
}


