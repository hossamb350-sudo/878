rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    
    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow list, delete: if isAdmin();
      allow read: if isAdmin();

      // User reading platform data rules
      match /bookmarks/{bookmarkId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
      match /notes/{noteId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
      match /highlights/{highlightId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
      match /stats/{statId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }
    
    match /news/{document=**} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
      allow write: if isAdmin();
    }
    
    match /videos/{document=**} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
      allow write: if isAdmin();
    }
    
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /livestreams/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /leader/{document=**} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
      allow write: if isAdmin();
    }
    
    match /events/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /urgentNews/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /notifications/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /quran_series/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /quran_lessons/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /quran_syllabuses/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /quran_excerpts/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
