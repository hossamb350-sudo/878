rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    
    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isManager() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager';
    }

    function isEditor() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'editor';
    }

    function hasPermission(section) {
      let data = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return ('permissions' in data) && (data.permissions != null) && (data.permissions.hasAny([section]));
    }

    function canManage(section) {
      return isAdmin() || 
             (isManager() && section in ['news', 'urgentNews', 'videos', 'leader', 'quran', 'social_links']) || 
             (isEditor() && hasPermission(section));
    }
    
    function isStaff() {
      return isAdmin() || isManager() || isEditor();
    }

    function isValidSocialLink(data) {
      return data.keys().hasAll(['platform', 'label', 'url', 'order', 'createdAt']) &&
             data.keys().size() <= 6 &&
             data.platform is string && data.platform.size() <= 100 &&
             data.label is string && data.label.size() <= 100 &&
             data.url is string && data.url.size() <= 1000 &&
             ( !('description' in data) || (data.description is string && data.description.size() <= 500) ) &&
             data.order is number &&
             data.createdAt is number;
    }
    
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow list, delete: if isAdmin();
      allow read: if isAdmin();

      // User reading platform data rules
      match /bookmarks/{bookmarkId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
      match /notes/{noteId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
      match /highlights/{highlightId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
      match /stats/{statId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
      match /progress/{lessonId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
      match /lastRead/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }
    
    match /news/{document=**} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
      allow write: if canManage('news');
    }
    
    match /videos/{document=**} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
      allow write: if canManage('videos');
    }
    
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /livestreams/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /leader/{document=**} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
      allow write: if canManage('leader');
    }
    
    match /events/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /deletions/{document=**} {
      allow read: if true;
      allow write: if isStaff();
    }
    
    match /urgentNews/{document=**} {
      allow read: if true;
      allow write: if canManage('urgentNews');
    }
    
    match /notifications/{document=**} {
      allow read: if true;
      allow write: if isStaff();
    }
    
    match /newsMetadata/{document=**} {
      allow read: if true;
      allow write: if canManage('news');
    }
    
    match /quran_series/{document=**} {
      allow read: if true;
      allow write: if canManage('quran');
    }
    
    match /quran_lessons/{document=**} {
      allow read: if true;
      allow write: if canManage('quran');
    }
    
    match /quran_syllabuses/{document=**} {
      allow read: if true;
      allow write: if canManage('quran');
    }
    
    match /quran_excerpts/{document=**} {
      allow read: if true;
      allow write: if canManage('quran');
    }

    match /social_links/{document=**} {
      allow read: if true;
      allow create, update: if canManage('social_links') && isValidSocialLink(request.resource.data);
      allow delete: if canManage('social_links');
    }
  }
}
